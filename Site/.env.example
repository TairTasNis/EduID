# Точный URL из Firebase Console → Realtime Database.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Только на сервере. Укажите путь к JSON для локального запуска.
GOOGLE_APPLICATION_CREDENTIALS=
# Для Vercel укажите содержимое JSON сервисного аккаунта в одну строку.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Стабильный случайный ключ. Смена ключа изменит UID аккаунтов учеников.
EDUID_ID_HMAC_KEY=

GRADE_API_URL=https://158.180.63.46:5091/v1/grades
GRADE_API_KEY=
# Корневой сертификат из certs/grade-api-ca.pem. Допускаются переносы или символы \n.
GRADE_API_CA_PEM=
