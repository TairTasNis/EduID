{
  "rules": {
    ".read": false,
    ".write": false,
    "students": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.accountType === 'student'",
        "achievements": {
          ".write": "auth != null && auth.uid === $uid && auth.token.accountType === 'student'"
        },
        "notifications": {
          ".write": "auth != null && auth.uid === $uid && auth.token.accountType === 'student'"
        }
      }
    },
    "organizationStatus": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "organizations": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    }
  }
}
